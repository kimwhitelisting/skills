{
  "name": "bento-life",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "build:preview": "for e in preview proto-follow proto-order proto-day proto-pixel proto-parts; do PREVIEW_ENTRY=$e vite build --mode preview-page && node --experimental-strip-types scripts/make-preview.ts $e || exit 1; done",
    "preview": "vite preview --host",
    "test": "vitest run tests/game.test.ts",
    "balance": "vitest run tests/balance.report.test.ts",
    "typecheck": "tsc",
    "gen:menus": "node --experimental-strip-types scripts/generate-menus.ts",
    "gen:art": "vite-node scripts/generate-art-list.ts",
    "export:parts": "vite-node scripts/export-parts.ts",
    "draw:ingredients": "node --experimental-strip-types scripts/draw-ingredients.ts",
    "endings": "vite-node scripts/ending-report.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "galmuri": "^2.40.3"
  }
}
